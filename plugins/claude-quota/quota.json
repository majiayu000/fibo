{
  "api": 1,
  "sources": [
    {
      "agent": "claude",
      "command": "\"$MOORING_BIN\" claude-quota usage",
      "refresh_s": 60,
      "timeout_ms": 20000,
      "at": "/at",
      "windows": [
        {
          "minutes": 300,
          "used": "/session/used",
          "resets_at": "/session/resets_at"
        },
        {
          "minutes": 10080,
          "used": "/week/used",
          "resets_at": "/week/resets_at"
        },
        {
          "minutes": 10080,
          "name": "/models/0/name",
          "used": "/models/0/used",
          "resets_at": "/models/0/resets_at"
        },
        {
          "minutes": 10080,
          "name": "/models/1/name",
          "used": "/models/1/used",
          "resets_at": "/models/1/resets_at"
        },
        {
          "minutes": 10080,
          "name": "/models/2/name",
          "used": "/models/2/used",
          "resets_at": "/models/2/resets_at"
        }
      ],
      "error": "/error"
    }
  ]
}
