{
  "expo": {
    "name": "Fibo",
    "slug": "mooring-mobile",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mooring.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "连接同一个 Wi‑Fi 里电脑上的 Fibo 中继",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B5FD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.mooring.mobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "选图片发给电脑上的 Agent",
          "cameraPermission": "拍照发给电脑上的 Agent",
          "microphonePermission": "把你说的话转成文字，发给电脑上的 Agent"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描电脑上 Fibo 显示的配对二维码",
          "microphonePermission": "把你说的话转成文字，发给电脑上的 Agent",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/JetBrainsMonoNL-Regular.ttf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "把你说的话转成文字，发给电脑上的 Agent",
          "speechRecognitionPermission": "用系统的语音识别把你说的话转成文字"
        }
      ]
    ],
    "scheme": "mooring",
    "experiments": {
      "typedRoutes": true
    }
  }
}
