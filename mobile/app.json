{
  "expo": {
    "name": "Mooring",
    "slug": "mooring-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mooring.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "连接同一个 Wi‑Fi 里电脑上的 Mooring 中继",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.mooring.mobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "选图片发给电脑上的 Agent",
          "cameraPermission": "拍照发给电脑上的 Agent",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许审批和打开 Mooring 前用 Face ID 确认是你"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描电脑上 Mooring 显示的配对二维码",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/JetBrainsMonoNL-Regular.ttf"
          ]
        }
      ]
    ],
    "scheme": "mooring",
    "experiments": {
      "typedRoutes": true
    }
  }
}
