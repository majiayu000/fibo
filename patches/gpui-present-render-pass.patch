--- a/crates/gpui_apple/src/shaders.metal
+++ b/crates/gpui_apple/src/shaders.metal
@@ -1277,3 +1277,14 @@ float4 fill_color(Background background,
 
   return color;
 }
+
+// Copies the retained back buffer into the drawable, pixel for pixel.
+vertex float4 present_vertex(uint vertex_id [[vertex_id]]) {
+  float2 corners[3] = {float2(-1., -1.), float2(3., -1.), float2(-1., 3.)};
+  return float4(corners[vertex_id], 0., 1.);
+}
+
+fragment float4 present_fragment(float4 position [[position]],
+                                 texture2d<float, access::read> source [[texture(0)]]) {
+  return source.read(uint2(position.xy));
+}
